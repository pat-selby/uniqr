{
  "name": "uniqr-demo",
  "private": true,
  "version": "1.0.0",
  "description": "A short demo video of UniQR, made with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render UniQRDemo out/uniqr-demo.mp4",
    "render:square": "remotion render UniQRDemoSquare out/uniqr-demo-square.mp4",
    "render:web": "remotion render UniQRDemo out/uniqr-demo-web.mp4 --scale=0.5 --crf=30 --audio-bitrate=96k",
    "render:web:mac": "remotion render UniQRDemoMac out/uniqr-demo-web-mac.mp4 --scale=0.5 --crf=30 --audio-bitrate=96k",
    "render:web:linux": "remotion render UniQRDemoLinux out/uniqr-demo-web-linux.mp4 --scale=0.5 --crf=30 --audio-bitrate=96k",
    "still": "remotion still UniQRDemo out/still.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.530",
    "bwip-js": "4.11.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
