#include <winver.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/resource.h"

IDI_UNIQR ICON "@CMAKE_CURRENT_SOURCE_DIR@/uniqr.ico"

1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Patrick Selby"
      VALUE "FileDescription", "UniQR (C++): read any QR code on your screen"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "uniqr-cpp"
      VALUE "LegalCopyright", "MIT licence"
      VALUE "OriginalFilename", "uniqr-cpp.exe"
      VALUE "ProductName", "UniQR (C++)"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
