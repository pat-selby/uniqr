<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for the UniQR launch agent on macOS. Do not copy this file by hand:
  it holds example paths, and launchd cannot expand "~" or "$HOME", so a copy
  points at someone else's username and fails with status 78.

  Install it with the script, which fills in this Mac's paths and creates the
  log folder launchd needs:

    python3 tools/install_mac_agent.py

  Everything that is not a path is read from here: start at login, and restart
  if it stops, but not in a tight loop.

  macOS grants Screen Recording and Accessibility to the program that runs, and
  launchd runs the venv's python, which counts as a different program from
  Terminal. The script prints what to add and where.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.patselby.uniqr</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/pescybers_mac/Downloads/uniqr/.venv/bin/python</string>
        <string>/Users/pescybers_mac/Downloads/uniqr/app.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/pescybers_mac/Downloads/uniqr</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>UNIQR_HOTKEY</key>
        <string>&lt;cmd&gt;+&lt;shift&gt;+8</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart it if it ever stops, but not in a tight loop. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/pescybers_mac/Library/Logs/UniQR/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/pescybers_mac/Library/Logs/UniQR/launchd.log</string>
</dict>
</plist>
